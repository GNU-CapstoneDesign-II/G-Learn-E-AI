# # 예: ENV DB_HOST=mysql_db
# # (기본값은 mysql_db라고 두고, docker-compose에서 override 가능)
# ENV DB_HOST=mysql_db
#
# # 실행 커맨드 (main.py 내부에 app = FastAPI() 객체가 있다고 가정)
